{
  "id": "plural-nouns",
  "title": "Plural Nouns: -s, -es, -ies & Irregular",
  "subject": "English Reading",
  "category": "Grammar",
  "source": "Two provided plural noun worksheets",
  "rules": [
    {
      "name": "Add -s",
      "description": "Most nouns",
      "example": "book → books"
    },
    {
      "name": "Add -es",
      "description": "Often nouns ending s, x, z, ch, sh",
      "example": "box → boxes"
    },
    {
      "name": "Change y to -ies",
      "description": "Consonant before y",
      "example": "berry → berries"
    },
    {
      "name": "Keep y, add -s",
      "description": "Vowel before y",
      "example": "toy → toys"
    },
    {
      "name": "Irregular",
      "description": "Plural changes differently or stays the same",
      "example": "mouse → mice"
    }
  ],
